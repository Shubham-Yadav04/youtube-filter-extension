{
  "manifest_version": 3,
  "name": "Focus Filter",
  "version": "3.0.0",
  "description": "AI-powered YouTube content filter using local semantic classification.",

  "action": {
    "default_popup": "index.html"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "*://www.youtube.com/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
